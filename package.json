    "@x402/fetch": "2.26.0",
    "express": "5.1.0",
    "litesvm": "1.5.0",
    "qrcode": "1.5.4",
    "tweetnacl": "1.0.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@solana/kit": "8.0.0",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
