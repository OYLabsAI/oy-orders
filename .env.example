# Rehearsal never sends transactions or claims sponsor execution.
MODE=rehearsal
PORT=8787
PUBLIC_API_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:8787
DATA_DIR=.local
# Live mode fails closed until every required integration is configured.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_WORKER_KEYFILE=.local/worker.json
SOLANA_AUTHORITY_KEYFILE=.local/authority.json
NOWNODES_API_KEY=
# Optional: without this key, the signer and independent CRE payment read use
# the public Koios preprod API. NOWNodes still supplies both MAINNET reports.
BLOCKFROST_PREPROD_KEY=
CARDANO_SELLER_ADDRESS=
CRE_BIN=.local/bin/cre
CRE_WORKFLOW_DIR=workflows/verify-order
CRE_TARGET=staging-settings
# Set true only after successful official CLI login.
CRE_AUTHENTICATED=false
# Alternatively provide the officially supported CRE_API_KEY via a secret store.
